NODE_ENV=development
PORT=4000

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=8h

# Cookie
COOKIE_SECURE=false

# Database (sqlite file path)
DB_PATH=./data/emp_portal.db

# Attendance rules (all in minutes unless noted)
STANDARD_WORK_HOURS=8
MAX_BREAK_MINUTES=60
LATE_LOGIN_THRESHOLD=09:15
HALF_DAY_THRESHOLD_HOURS=4

# CORS
CLIENT_ORIGIN=http://localhost:4000
